# editor / OS cruft
*~
#*#
.#*
.DS_Store
.saveAsk
__pycache__/
*.pyc

# timetable / attendance exports (contain live attendance QR links --
# must never be published: anyone with the links can register attendance)
*.csv
myengage.csv
lectures/myengage.csv

# LaTeX auxiliary files
*.aux
*.log
*.out
*.toc
*.nav
*.snm
*.vrb
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
*.old
_region_.*
texput.*
supp-pdf.*

# asymptote intermediates
*.pre

# lectures: per-lecture PDFs are build output, rebuilt by ./build
lectures_dev/*.pdf
lectures_dev/build_tmp/
old_lectures/

# problem sheets: pdflatex writes everything here via -output-directory,
# and ./build copies the finished PDFs to site/problem_pdf
problems/_build/

# Spreadsheets are not versioned: they are downloaded or generated, and they
# often carry personal data (staff details, student numbers, attendance QR
# links). Add an explicit exception if a particular file really is source.
*.csv
*.tsv
