#!/usr/bin/env python
r"""Generate ../site/lectures.html from lectures.yaml.

Differences from the old lectures/lecturehtml:
  * the lecture list comes from lectures.yaml, not from grepping lectures.tex
  * subsidiary.yml is optional (the old script crashed when it was absent)
  * it does NOT git add/commit/push -- generate the html, review it, then
    commit and push yourself
"""

import os
import shutil

import yaml

import lecture_list

SITE = lecture_list.config().get("site_dir", "../site")
SUBSIDIARY = "subsidiary.yml"

HEADER = '''<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="stylesheet" href="style.css">
<title>Lecture Notes</title>
</head>
<body>
<header>Lecture Notes</header>
<div class="container">
<p><a href="index.html">&larr; Course home</a></p>
<h2>Lessons on Mathematics for Machine Learning</h2>

<ol>
'''

FOOTER = '''
</ol>

<ul>
<li> <a href="lecture_pdf/lectures_8.pdf">Complete set of Notes</a></li>
</ul>

</div>
<footer>ECS &mdash; AICE3001/AICE6002: Mathematics of Machine Learning</footer>
</body>
</html>
'''


def load_subsidiary():
    if not os.path.isfile(SUBSIDIARY):
        return {}
    with open(SUBSIDIARY) as f:
        return yaml.safe_load(f) or {}


def main():
    subsidiary = load_subsidiary()
    lectures = lecture_list.load()
    os.makedirs(SITE, exist_ok=True)

    with open(f"{SITE}/lectures.html", "w") as html:
        html.write(HEADER)
        for lec in lectures:
            html.write(f'<li><b>{lec.title}</b>: {lec.keywords}\n')
            html.write(f'<div id="{lec.id}">\n')
            html.write('<ul> <li> '
                       f'<a href="lecture_pdf/{lec.id}.pdf">Lecture PDF</a>,\n'
                       f'  <a href="lecture_pdf/{lec.id}_prn.pdf">Printable PDF</a>,\n'
                       f'  <a href="lecture_pdf/{lec.id}_prn_4.pdf">(4 per page)</a>,\n'
                       f'  <a href="lecture_pdf/{lec.id}_prn_8.pdf">(8 per page)</a>\n'
                       '</li>\n</ul>\n')
            html.write('</div>\n')

            if lec.id in subsidiary:
                html.write("<ul>\n")
                for k, v in subsidiary[lec.id].items():
                    os.makedirs(f"{SITE}/code/{lec.id}", exist_ok=True)
                    shutil.copy(f"code/{v}", f"{SITE}/code/{lec.id}/{v}")
                    html.write(f' <li>{k}: <a href="code/{lec.id}/{v}">{v}</a> </li>\n')
                html.write("</ul>\n")
            html.write("</li>\n")
        html.write(FOOTER)

    print(f"wrote {SITE}/lectures.html ({len(lectures)} lectures)")
    for p in lecture_list.check():
        print(f"WARNING: {p}")
    print("\nnot committed or pushed -- review it, then commit and push yourself")


if __name__ == "__main__":
    main()
