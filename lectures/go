#!/usr/bin/env python
r"""Pick a lecture, build it if needed, and open it in the presenter.

Same job as the old `go`, but the menu comes from lectures.yaml instead of
grepping \lecture{...} out of lectures.tex, and the lecture is compiled as a
standalone document rather than through the master file.

    ./go            choose from the lectures in `lectures:`
    ./go --all      choose from every lecture that has a .tex file
"""

import os
import sys
from time import sleep

import psutil
from ask import Ask
from myengage import myengage

import lecture_list

BUILD = "build_tmp"
DEPS = ["preamble.tex", "macros_gen.tex"]


def newer(a, b):
    if not os.path.exists(b):
        return True
    if not os.path.exists(a):
        return False
    return os.path.getmtime(a) > os.path.getmtime(b)


def main():
    section = "all" if "--all" in sys.argv else "lectures"
    lectures = [l for l in lecture_list.load(section=section) if l.exists]
    if not lectures:
        print(f"no lectures in '{section}' have a .tex file")
        sys.exit(1)

    for i, lec in enumerate(lectures, 1):
        print(f"{i:3}  {lec.id:24} {lec.title}")

    query = Ask()
    ids = [l.id for l in lectures]
    choice = query("What file do you want to show", "fn", 1, ids)
    lec = lectures[int(choice) - 1]

    pdf = f"{BUILD}/{lec.id}_pp4.pdf"
    if newer(lec.tex, pdf) or any(newer(d, pdf) for d in DEPS):
        print(f"building {lec.id} ...")
        if os.system(f"/Library/TeX/texbin/pdflatex -shell-escape -halt-on-error "
                     f"-interaction=nonstopmode {lec.id}") != 0:
            print("Latex failed")
            sys.exit(1)
        os.makedirs(BUILD, exist_ok=True)
        os.system(f"ppower4 {lec.id}.pdf {pdf}")

    # skip zombies: they own no window, and counting one would stop this
    # script opening anything. kill_papers handles the live-but-windowless case.
    running = any(proc.info["name"] == "evince"
                  and proc.info["status"] != psutil.STATUS_ZOMBIE
                  for proc in psutil.process_iter(["name", "status"]))
    print(pdf, lec.tex, running, lec.id)

    if not running:
        os.system(f"evince {pdf} 2> /dev/null &")
        sleep(2)
        myengage()


if __name__ == "__main__":
    main()
