size(100,0);

for(int i=0; i<4; ++i)
  draw((0,i)--(4,i), linewidth(2)+gray);

draw((6,-0.5)--(6,3.5), linewidth(2)+gray);

draw((-0.3,-0.2)..(-0.7,1.5)..(-0.3,3.2));
draw((4.3,-0.2)..(4.7,1.5)..(4.3,3.2));

draw((6-0.3,-0.7)..(6-0.7,1.5)..(6-0.3,3.7));
draw((6.3,-0.7)..(6.7,1.5)..(6.3,3.7));

label("$=$", (7.5,1.5));

for(int j=0; j<4; ++j) {
  filldraw(box((9-0.3,j-0.3),(9+0.3,j+0.3)),gray, white);
}

draw((9-0.5,-0.2)..(9-0.8,1.5)..(9-0.5,3.2));
draw((9.5,-0.2)..(9.8,1.5)..(9.5,3.2));


