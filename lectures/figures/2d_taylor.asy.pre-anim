import myutil;
import three;
import graph3;
size(400,0);

real f(pair xy) {
real x = xy.x; real y = xy.y;
return 2*exp(-0.5*x*x - y*y)  + exp(-0.5*(x-1)*(x-1) - (y-2)*(y-2));
}


pair bbmin = (-3, -3);
pair bbmax = (5,4);
surface s = surface(f, bbmin, bbmax, Spline);
draw(s, surfacepen=paleblue);


draw(-3X--5.2X, Arrow3);
draw(-3Y--4.2Y, Arrow3);
draw(O--2.4Z, Arrow3);
label("$x_1$", 5.3X);
label("$x_2$", 4.3Y);
label("$f(\bm{x})$", 2.5Z);

ship();

pair p = (2,1.5);
triple p3 = (p.x, p.y, f(p));

dot(p3, red);

ship();
