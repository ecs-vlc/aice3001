size(100,0);

for(int i=0; i<4; ++i)
  draw((0,i)--(4,i), linewidth(2)+gray);

for(int i=0; i<3; ++i)
  draw((6+i,-0.5)--(6+i,3.5), linewidth(2)+gray);

draw((-0.3,-0.2)..(-0.7,1.5)..(-0.3,3.2));
draw((4.3,-0.2)..(4.7,1.5)..(4.3,3.2));

draw((6-0.3,-0.7)..(6-0.7,1.5)..(6-0.3,3.7));
draw((8.3,-0.7)..(8.7,1.5)..(8.3,3.7));

label("$=$", (9.9,1.5));

for(int i=0; i<3; ++i) {
  for(int j=0; j<4; ++j) {
    filldraw(box((12+i-0.3,j-0.3),(12+i+0.3,j+0.3)),gray, white);
  }
}
draw((12-0.5,-0.2)..(12-0.8,1.5)..(12-0.5,3.2));
draw((14.5,-0.2)..(14.8,1.5)..(14.5,3.2));
