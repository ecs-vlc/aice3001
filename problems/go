#!/usr/bin/env python
"""Pick a problem sheet, build it, and open both PDFs in the viewer.

Building is delegated to ./build, so there is one definition of how a sheet
is compiled. The PDFs live in _build/; ./build also copies them to the site.

The viewer is evince rather than Preview for two reasons: Preview overlays a
page count that cannot be turned off, which is intrusive on animated slides,
and evince re-renders a PDF in place when the file changes. That second
behaviour is the point of the edit-rebuild-look loop, and it is why a viewer
that is already open is left alone below rather than having a second window
stacked on top of it.

    ./go             choose a sheet; open questions and answers side by side
    ./go --tutorial  for the start of a Friday tutorial: open only the
                     questions, then show the seat code and the sheet's URL
                     in a full-screen Space of their own. Swipe (or
                     Ctrl-arrow) to the desktop to reach the questions. The
                     default sheet is the one taught at the next tutorial in
                     ../lectures/myengage.csv. Escape or q closes the code.
"""

import subprocess
import sys
import time
from datetime import date, datetime
from pathlib import Path

import psutil
import yaml
from ask import Ask
from myengage import read_lectures

HERE = Path(__file__).resolve().parent
BUILD_DIR = HERE / "_build"
VIEWER = "evince"
SEATS_CSV = HERE.parent / "lectures" / "myengage.csv"
TUTORIAL_DATES = HERE / "tutorial_dates.yaml"
# Where make_problems_html.py publishes the question PDFs (site/problem_pdf/).
SHEET_URL = "https://ecs-vlc.github.io/aice3001/problem_pdf/{name}.pdf"


def viewer_running() -> bool:
    """Is a usable viewer open?

    A zombie is skipped: it has exited but not been reaped, so it owns no
    window. Counting one would make this script decline to open anything and
    leave nothing on screen. It does not cover a live but window-less process
    -- psutil cannot tell whether a process owns a window -- so kill_papers
    remains the escape hatch.
    """
    for proc in psutil.process_iter(["name", "status"]):
        if proc.info["name"] != VIEWER:
            continue
        if proc.info["status"] == psutil.STATUS_ZOMBIE:
            continue
        return True
    return False


def main() -> None:
    tutorial_mode = "--tutorial" in sys.argv
    sheets = yaml.safe_load((HERE / "problems.yaml").read_text())["sheets"]
    for i, sheet in enumerate(sheets, 1):
        marker = "" if (HERE / f"{sheet['name']}.tex").exists() else "   (no .tex)"
        print(f"{i:3}  week {sheet['week']}: {sheet['name']} ({sheet['keywords']}){marker}")

    names = [s["name"] for s in sheets]
    if tutorial_mode:
        tutorial = next_tutorial()
        name = choose_sheet(names, sheet_taught_on(tutorial["start"].date())
                            if tutorial else None)
    else:
        choice = int(Ask()("What problem do you want to see", "sheet", 1, names)) - 1
        name = names[choice]

    if subprocess.call([sys.executable, str(HERE / "build"), name], cwd=HERE) != 0:
        print(f"build failed -- see _build/{name}.log")
        sys.exit(1)

    pdfs = [BUILD_DIR / f"{name}.pdf", BUILD_DIR / f"{name}_answers.pdf"]
    missing = [p.name for p in pdfs if not p.exists()]
    if missing:
        print("not produced: " + ", ".join(missing))
        sys.exit(1)

    if tutorial_mode:
        start_tutorial(name, pdfs[0], tutorial)
        return

    if viewer_running():
        # evince reloads the file it already has open, so a rebuild of the
        # same sheet needs nothing further. Opening a different sheet does:
        print(f"{VIEWER} is already open -- it will reload if this is the same "
              f"sheet. Otherwise:")
        for pdf in pdfs:
            print(f"    {VIEWER} {pdf}")
        return

    for pdf in pdfs:
        subprocess.Popen([VIEWER, str(pdf)],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    tile_side_by_side()


def next_tutorial() -> dict | None:
    """The next tutorial in myengage.csv that has not yet finished."""
    now = datetime.now()
    return next((t for t in read_lectures(str(SEATS_CSV))
                 if t["type"] == "Tutorial" and t["end"] >= now), None)


def sheet_taught_on(day: date) -> str | None:
    """The sheet whose tutorial is on this day, from tutorial_dates.yaml."""
    if not TUTORIAL_DATES.exists():
        return None
    dates = yaml.safe_load(TUTORIAL_DATES.read_text()) or {}
    return next((name for name, d in dates.items() if d == day), None)


def choose_sheet(names: list[str], default: str | None) -> str:
    """Ask for a sheet by number or name, defaulting to the tutorial's sheet.

    Ask is not used here: it would offer last time's choice, whereas the
    right default for a tutorial is whatever that week's tutorial covers.
    """
    shown = default or "none"
    while True:
        ans = input(f"Which sheet for the tutorial [{shown}]? ").strip()
        if not ans and default:
            return default
        if ans in names:
            return ans
        if ans.isdigit() and 1 <= int(ans) <= len(names):
            return names[int(ans) - 1]
        print(f"  enter 1-{len(names)} or a sheet name")


def start_tutorial(name: str, pdf: Path, tutorial: dict | None) -> None:
    """Open the questions, then show the seat code in front of them."""
    published = HERE.parent / "site" / "problem_pdf" / pdf.name
    if not published.exists():
        print(f"warning: {published} is missing, so the URL will not work "
              f"until the site is rebuilt and pushed")

    subprocess.Popen([VIEWER, str(pdf)], stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL)
    # Let evince's window appear before the code goes full screen. A window
    # opening while a full-screen Space is showing makes macOS switch back
    # to the desktop, which would hide the code.
    time.sleep(2)

    url = SHEET_URL.format(name=name)
    if tutorial is None:
        print(f"No tutorial left in {SEATS_CSV}. Download a new one from")
        print("https://southampton.seats.cloud/angular/#/lectures/")
        code, label = "", ""
    else:
        code, label = tutorial["code"], tutorial["label"]
        print(f"{tutorial['type']} in {tutorial['location']}")
        print(f"{tutorial['start']:%a %d %b %H:%M}: {code}")
        if tutorial["start"].date() != date.today():
            print(f"  (not today: this is the code for "
                  f"{tutorial['start']:%a %d %b})")
    print(url)
    show_code(code, url, label)
    raise_viewer()


def show_code(code: str, url: str, label: str) -> None:
    """The seat code and the sheet's URL full screen until Escape or q.

    Like myengage's countdown window but without the timer, since a
    tutorial has no fixed moment at which the code should go. Unlike that
    window, this one uses Tk's -fullscreen, which on macOS is native full
    screen: the code gets a Space of its own and the questions stay on the
    desktop, one swipe away. That suits a mirrored projector, where there is
    no second display to put the questions on.
    """
    import tkinter as tk
    from tkinter import font as tkfont

    bg, fg = "#264941", "yellow"
    root = tk.Tk()
    root.title("Seat code for tutorial")
    root.attributes("-fullscreen", True)
    width = root.winfo_screenwidth()
    root.configure(background=bg)
    root.bind_all("<Escape>", lambda e: root.destroy())
    root.bind_all("<KeyPress-q>", lambda e: root.destroy())

    tk.Label(root, text=code, font=("times", 360), fg=fg, bg=bg).pack(
        expand=True)

    # A URL that ran off the side of the screen would be useless, so the
    # font shrinks until it fits.
    url_font = tkfont.Font(family="Helvetica", size=72)
    while url_font.cget("size") > 12 and url_font.measure(url) > width - 40:
        url_font.configure(size=url_font.cget("size") - 2)
    tk.Label(root, text=url, font=url_font, fg=fg, bg=bg).pack(pady=(0, 40))

    info_font = tkfont.Font(family="Helvetica", size=48)
    while (info_font.cget("size") > 12 and
           max(map(info_font.measure, label.splitlines() or [""])) > width - 40):
        info_font.configure(size=info_font.cget("size") - 2)
    tk.Label(root, text=label, font=info_font, justify="left",
             fg=fg, bg=bg).pack(anchor="w", padx=10, pady=10)

    root.lift()
    root.focus_force()
    root.after(100, root.focus_force)
    root.mainloop()


def raise_viewer() -> None:
    """Bring the viewer to the front once the code window has gone."""
    subprocess.run(["osascript", "-e",
                    f'tell application "System Events" to set frontmost'
                    f' of process "{VIEWER}" to true'], capture_output=True)


# The fn-Control-arrow tiling shortcut never reaches evince, so the two
# windows are placed directly. Only the position can be set: evince reports
# AXSize as not settable, so the windows keep their own size and are merely
# moved apart. A native app would accept the size too.
TILE_SCRIPT = r"""
ObjC.import('AppKit');
const se = Application('System Events');

// Index the specifier (p.windows[i]), not the evaluated array
// (p.windows()[i]) -- in JXA every element of that array resolves to the
// same window, so both "windows" would be the same one.
let wins = [];
const procs = se.processes.whose({name: 'evince'});
for (let i = 0; i < procs.length; i++) {
  const p = procs[i];
  let n = 0;
  try { n = p.windows.length; } catch (e) { continue; }
  for (let j = 0; j < n; j++) wins.push({pid: p.unixId(), w: p.windows[j]});
}
if (wins.length < 2) { 'only ' + wins.length + ' window(s)'; }
else {
  // evince titles both windows after the first document, so order by pid:
  // the questions are launched first and so have the lower pid.
  wins.sort((a, b) => a.pid - b.pid);
  const a = wins[0].w, b = wins[1].w;
  const here = a.position();
  const mainH = $.NSScreen.mainScreen.frame.size.height;
  const screens = $.NSScreen.screens;
  let target = $.NSScreen.mainScreen;
  for (let i = 0; i < screens.count; i++) {            // keep them on the
    const s = screens.objectAtIndex(i), f = s.frame;   // display they are on
    const seTop = mainH - (f.origin.y + f.size.height);
    if (here[0] >= f.origin.x && here[0] < f.origin.x + f.size.width &&
        here[1] >= seTop && here[1] < seTop + f.size.height) { target = s; break; }
  }
  const v = target.visibleFrame;
  const top = mainH - (v.origin.y + v.size.height);
  const left = v.origin.x, halfW = Math.floor(v.size.width / 2);
  a.position = [left, top];
  b.position = [left + halfW, top];
  'placed';
}
"""


def tile_side_by_side(attempts: int = 10) -> None:
    """Move the two viewer windows to the left and right of the screen.

    Needs Accessibility permission for the terminal running this. Without it
    osascript returns -25211 and this quietly does nothing.
    """
    for _ in range(attempts):
        time.sleep(0.6)                       # let the windows appear
        result = subprocess.run(["osascript", "-l", "JavaScript", "-e", TILE_SCRIPT],
                                capture_output=True, text=True)
        out = (result.stdout + result.stderr).strip()
        if "placed" in out:
            return
        if "-25211" in out or "assistive access" in out:
            print("  (windows not moved: grant Accessibility permission to your "
                  "terminal in System Settings -> Privacy & Security)")
            return
    print("  (windows not moved: the viewer did not report two windows)")


if __name__ == "__main__":
    main()
